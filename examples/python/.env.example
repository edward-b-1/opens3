# OpenS3 connection settings for the Python test scripts.
OPENS3_ENDPOINT=https://devbox4.lan:9000
OPENS3_ACCESS_KEY=root
OPENS3_SECRET_KEY=password
OPENS3_REGION=us-east-1
# TLS certificate verification: true, false (self-signed dev certs), or a
# path to a CA bundle / the server's certificate (PEM). Plain http:// ignores it.
OPENS3_TLS_VERIFY=~/opens3-tls/tls.crt
# Bucket prefix; each script run uses buckets named <prefix>-<suffix>.
OPENS3_BUCKET_PREFIX=pyclient-test
